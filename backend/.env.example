# ===========================================
# 법률 서비스 플랫폼 환경 변수 설정
# ===========================================
# 사용법: cp .env.example .env 후 값을 변경하세요.

APP_NAME=Law Platform API
DEBUG=false

# 환경: development | docker | production
ENVIRONMENT=development

# ===========================================
# Database (필수)
# ===========================================
# PostgreSQL 연결 문자열
# 형식: postgresql://사용자:비밀번호@호스트:포트/데이터베이스명
DATABASE_URL=postgresql://user:password@localhost:5432/lawdb

# ===========================================
# CORS
# ===========================================
CORS_ORIGINS=["http://localhost:3000"]

# ===========================================
# LLM 설정
# ===========================================
# LLM 프로바이더 선택: openai | anthropic | google
LLM_PROVIDER=openai

# OpenAI API (필수) - AI 기능 (판례 분석, 문서 생성, RAG 등)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude) - LLM_PROVIDER=anthropic 일 때 사용
# 발급: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google (Gemini) - LLM_PROVIDER=google 일 때 사용
# 발급: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3-flash-preview

# LLM 타임아웃 (초)
LLM_TIMEOUT_SECONDS=60

# 에이전트 노드 전체 타임아웃 (초)
AGENT_TIMEOUT_SECONDS=120

# ===========================================
# API Keys (외부 서비스)
# ===========================================

# 카카오 API (변호사 찾기 기능 사용 시 필요)
# 발급: https://developers.kakao.com → 내 애플리케이션 → 앱 키
# 주의: 플랫폼 설정에서 http://localhost:3000 도메인 등록 필요
KAKAO_MAP_API_KEY=your_javascript_key
KAKAO_REST_API_KEY=your_rest_api_key

# Upstage Solar API (자동 질문 생성용)
# 발급: https://console.upstage.ai
UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-pro

# ===========================================
# Vector DB 설정
# ===========================================
# 사용할 벡터 DB 선택 (chroma, qdrant, lancedb)
VECTOR_DB=lancedb

# --- ChromaDB 설정 (VECTOR_DB=chroma) ---
CHROMA_COLLECTION_NAME=legal_documents
CHROMA_PERSIST_DIR=./data/chroma

# --- Qdrant 설정 (VECTOR_DB=qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=legal_documents

# --- LanceDB 설정 (VECTOR_DB=lancedb) ---
LANCEDB_URI=./lancedb_data
LANCEDB_TABLE_NAME=legal_chunks
# 벡터 인덱스 타입 (빈 문자열: brute-force, "IVF_FLAT" 등)
LANCEDB_INDEX_TYPE=IVF_FLAT
# IVF 인덱스 검색 시 탐색할 파티션 수 (높을수록 정확, 느림)
LANCEDB_NPROBES=30
# LanceDB 모드: local (임베디드) | remote (마이크로서비스)
# remote 모드 시: docker compose up -d lancedb 필요
LANCEDB_MODE=local
# remote 모드 시 마이크로서비스 URL
# docker-compose 내부 네트워크: http://lancedb:8100
# 로컬 개발: http://localhost:8100
LANCEDB_SERVICE_URL=http://localhost:8100
LANCEDB_SERVICE_TIMEOUT=30.0

# ===========================================
# 임베딩 설정
# ===========================================
# OpenAI 임베딩 API 배치 크기
EMBEDDING_BATCH_SIZE=100
# OpenAI 임베딩 모델 (USE_LOCAL_EMBEDDING=false 일 때 사용)
EMBEDDING_MODEL=text-embedding-3-small
# 로컬 임베딩 모델 (KURE-v1: 1024차원, 한국어 최적화)
LOCAL_EMBEDDING_MODEL=nlpai-lab/KURE-v1
# 로컬 임베딩 사용 여부 (true: 무료, false: OpenAI API 비용 발생)
USE_LOCAL_EMBEDDING=true

# ===========================================
# 검색 설정
# ===========================================
# 하이브리드 검색 (벡터 + FTS 키워드 결합)
USE_HYBRID_SEARCH=true
# MeCab 사용자 사전 경로 (법률 복합명사 인식)
MECAB_USERDIC_PATH=data/mecab_userdic/legal_terms.dic

# ===========================================
# 데이터 소스 설정
# ===========================================
# 변호사 데이터 소스 (true: PostgreSQL, false: JSON 파일)
# DB 사용 시: uv run alembic upgrade head && uv run python scripts/load_lawyers_data.py
USE_DB_LAWYERS=false

# 법률 용어 사전 (MeCab 토큰 보강)
# true: 앱 시작 시 PostgreSQL에서 법률 용어 로드 → MeCab 보강
# 사전 조건: uv run alembic upgrade head && uv run python scripts/load_legal_terms_data.py
USE_LEGAL_TERM_DICT=false

# 영속 체크포인터 (true: PostgreSQL, false: InMemory)
# LangGraph 에이전트 상태 영속 저장 여부
USE_PERSISTENT_CHECKPOINTER=true

# ===========================================
# 모듈 설정
# ===========================================
# 활성화할 모듈 (빈 배열이면 모든 모듈 활성화)
# 예시: ENABLED_MODULES=["lawyer_finder","case_precedent","small_claims"]
ENABLED_MODULES=[]

# ===========================================
# ONNX 최적화 (임베딩 & 리랭커)
# ===========================================
# ONNX 임베딩 사용 (쿼리 + 인제스트 배치, CUDA 자동 감지)
USE_ONNX_EMBEDDING=false
# ONNX 임베딩 variant: ort-opt (FP32 무손실) | ort-opt-qdq (INT8, cosine 0.999) | onnx-fp16 (FP16)
ONNX_EMBEDDING_VARIANT=ort-opt

# ONNX 리랭커 사용
USE_ONNX_RERANKER=false
# ONNX 리랭커 variant: ort-opt (FP32) | ort-opt-qdq (INT8)
ONNX_RERANKER_VARIANT=ort-opt

# ONNX 품질 게이트 (PyTorch 대비 cosine/pearson 검증)
ONNX_QUALITY_GATE_ENABLED=true
# 품질 미달 시 자동 PyTorch 폴백
ONNX_QUALITY_GATE_FALLBACK=true
# ORT 스레드 수 (0=자동)
ONNX_INTRA_OP_THREADS=0
# IO 바인딩 (GPU EP에서만 유의미, CPU EP에서 무효)
ONNX_ENABLE_IO_BINDING=false
# ONNX 추론 타임아웃 (초)
ONNX_INFERENCE_TIMEOUT_SECONDS=30.0
# Graviton3+ 전용 BF16 FastMath (Mac ARM 미지원)
ONNX_ENABLE_BF16_FASTMATH=false
# QDQ 민감 레이어 인덱스 (쉼표 구분, 빈 문자열이면 기본값)
ONNX_QDQ_SENSITIVE_LAYERS=

# ===========================================
# Context 압축 (LLMLingua-2)
# ===========================================
ENABLE_CONTEXT_COMPRESSION=false
COMPRESSION_MODEL=microsoft/llmlingua-2-xlm-roberta-large-meetingbank
COMPRESSION_DEFAULT_RATE=0.5
COMPRESSION_MIN_LENGTH=500
# "cpu" | "cuda"
COMPRESSION_DEVICE=cpu

# ===========================================
# Content Marketing (콘텐츠 마케팅 자동화)
# ===========================================
TAVILY_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
PERPLEXITY_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
NEWSDATA_API_KEY=
NEWSAPI_API_KEY=
CONTENT_MARKETING_CACHE_TTL=86400

# --- Keyword Flow (v2.1) ---
KEYWORD_COLLECT_CACHE_TTL=3600
KEYWORD_NEWS_CACHE_TTL=1800
KEYWORD_MAX_RESULTS=10
KEYWORD_NEWS_MAX_RESULTS=10
KEYWORD_COMMUNITY_DOMAINS=["dcinside.com","fmkorea.com","theqoo.net","bobaedream.co.kr","inven.co.kr"]
KEYWORD_COLLECT_RATE_LIMIT=5
KEYWORD_NEWS_RATE_LIMIT=30

# --- Legal Gate + 5차원 가중합 스코어링 (v2.1) ---
TREND_LEGAL_THRESHOLD=0.3
TREND_MENTION_WEIGHT=0.25
TREND_LEGAL_WEIGHT=0.6
TREND_CONTROVERSY_WEIGHT=0.20
TREND_SPREAD_WEIGHT=0.10
TREND_FITNESS_WEIGHT=0.25

# --- 페르소나 (v2.0) ---
PERSONA_MIN_HISTORY=30
PERSONA_CONFIDENCE_THRESHOLD=0.6

# ===========================================
# Neo4j Graph DB
# ===========================================
# 그래프 DB 연결 설정 (법령 계급, 판례 인용 관계 저장)
# Browser UI: http://localhost:7474
# 비밀번호: 루트 .env 파일의 NEO4J_PASSWORD와 일치해야 함
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_to_match_docker_compose

# ===========================================
# LangSmith 트레이싱
# ===========================================
# 발급: https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=law-platform
LANGCHAIN_API_KEY=

# ===========================================
# API 보안
# ===========================================
# API 인증 키 (빈 문자열이면 인증 비활성화)
API_KEY=

# Rate Limiting (분당 요청 수)
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_AI_PER_MINUTE=10
# 프로덕션: "redis://localhost:6379"
RATE_LIMIT_STORAGE_URI=memory://

# ===========================================
# RAG 평가 시스템 (evaluation 모듈)
# ===========================================
# Gradio UI 설정
EVAL_GRADIO_HOST=0.0.0.0
EVAL_GRADIO_PORT=7860
