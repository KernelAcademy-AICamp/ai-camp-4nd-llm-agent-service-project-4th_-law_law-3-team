# Backend Dockerfile - Production (Multi-stage, ARM/x86 compatible)
# MeCab-ko 소스 빌드로 aarch64(Graviton) 지원

# ============================================================
# Stage 1: MeCab 빌드 (소스 컴파일)
# ============================================================
FROM python:3.11-slim AS mecab-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget build-essential autoconf automake libtool \
    && rm -rf /var/lib/apt/lists/*

# mecab-ko 소스 빌드 (config.guess/sub 교체로 aarch64 지원)
RUN wget -q -O - https://bitbucket.org/eunjeon/mecab-ko/downloads/mecab-0.996-ko-0.9.2.tar.gz \
    | tar zxf - \
    && cd mecab-0.996-ko-0.9.2 \
    && cp /usr/share/misc/config.guess . \
    && cp /usr/share/misc/config.sub . \
    && ./configure && make -j$(nproc) && make install && ldconfig \
    && cd / && rm -rf mecab-0.996-ko-0.9.2

# mecab-ko-dic 소스 빌드
RUN wget -q -O - https://bitbucket.org/eunjeon/mecab-ko-dic/downloads/mecab-ko-dic-2.1.1-20180720.tar.gz \
    | tar zxf - \
    && cd mecab-ko-dic-2.1.1-20180720 \
    && autoreconf -fi && ./configure && make -j$(nproc) && make install && ldconfig \
    && cd / && rm -rf mecab-ko-dic-2.1.1-20180720

# ============================================================
# Stage 2: Python 의존성 설치
# ============================================================
FROM python:3.11-slim AS deps

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# uv 설치
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# 의존성 파일 복사 및 설치
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# ============================================================
# Stage 3: Runtime
# ============================================================
FROM python:3.11-slim AS runtime

WORKDIR /app

# 런타임 시스템 의존성 (ffmpeg: moviepy, curl: healthcheck, fonts-nanum: PDF 한글)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    fonts-nanum \
    && rm -rf /var/lib/apt/lists/*

# MeCab 라이브러리 및 사전 복사 (mecab-dict-index 등 빌드 도구는 런타임 불필요)
COPY --from=mecab-builder /usr/local/lib/libmecab* /usr/local/lib/
COPY --from=mecab-builder /usr/local/bin/mecab /usr/local/bin/
COPY --from=mecab-builder /usr/local/etc/mecabrc /usr/local/etc/
COPY --from=mecab-builder /usr/local/lib/mecab/ /usr/local/lib/mecab/
RUN ldconfig

# 비루트 사용자 생성
RUN groupadd -r appuser && useradd -r -g appuser appuser

# named volume 마운트 포인트를 appuser 소유로 미리 생성
# (Docker named volume이 빈 상태일 때 이미지의 디렉토리 권한을 상속함)
RUN mkdir -p /app/media /app/lancedb_data /app/models \
    && chown -R appuser:appuser /app/media /app/lancedb_data /app/models

# uv 복사
COPY --from=deps /root/.local/bin/uv /usr/local/bin/uv

# 가상환경 복사 (비루트 사용자 소유권 설정)
COPY --from=deps --chown=appuser:appuser /app/.venv /app/.venv

# 애플리케이션 코드 복사
COPY --chown=appuser:appuser . .

# entrypoint 스크립트 생성 (서버 시작 전 ML 모델 자동 다운로드)
RUN printf '#!/bin/sh\nset -e\necho "=== ML 모델 캐시 확인 ==="\npython scripts/download_models.py\necho "=== DB 마이그레이션 ==="\npython -m alembic upgrade head\necho "=== 서버 시작 ==="\nexec "$@"\n' > /app/entrypoint.sh \
    && chmod +x /app/entrypoint.sh

# 환경변수 설정
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV ENVIRONMENT=production
ENV UV_CACHE_DIR=/tmp/uv-cache

# 비루트 사용자로 전환
USER appuser

EXPOSE 8000

# 헬스체크
HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=5 \
    CMD curl -f http://localhost:8000/health || exit 1

# ML 모델 자동 다운로드 후 서버 실행
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
