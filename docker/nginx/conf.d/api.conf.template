upstream backend_upstream {
    server backend:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name ${API_DOMAIN};

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Health and docs
    location = /health {
        proxy_pass http://backend_upstream/health;
        proxy_read_timeout 30s;
    }

    location = /docs {
        proxy_pass http://backend_upstream/docs;
    }

    location = /redoc {
        proxy_pass http://backend_upstream/redoc;
    }

    location = /openapi.json {
        proxy_pass http://backend_upstream/openapi.json;
    }

    # API routes (disable buffering for streaming/SSE compatibility)
    location /api/ {
        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Backend media files
    location /media/ {
        proxy_pass http://backend_upstream;
        proxy_read_timeout 300s;
    }

    # Default deny to avoid exposing unexpected backend paths on root
    location / {
        return 404;
    }
}
