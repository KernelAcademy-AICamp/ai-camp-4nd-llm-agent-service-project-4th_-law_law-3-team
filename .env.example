# ===========================================
# Docker Compose 환경 변수
# ===========================================
# 사용법: cp .env.example .env 후 값을 변경하세요.
# 이 파일은 docker-compose.yml에서 참조합니다.
# .env 파일은 .gitignore에 포함되어 git에 커밋되지 않습니다.

# --- PostgreSQL ---
POSTGRES_USER=lawuser
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=lawdb

# --- LanceDB Service ---
LANCEDB_TABLE_NAME=legal_chunks

# --- Backup ---
# Docker 컨테이너 이름 (docker-compose.yml과 일치)
POSTGRES_CONTAINER=law-platform-db
# LanceDB 데이터 경로 (기본: backend/lancedb_data)
# LANCEDB_DATA_DIR=./backend/lancedb_data
# 로컬 백업 보관 개수 (기본: 5)
BACKUP_KEEP_LOCAL=5
# rclone 설정 파일 경로 (기본: 프로젝트 루트의 rclone.conf)
# RCLONE_CONF=./rclone.conf
# rclone 리모트 이름 (기본: gdrive)
# RCLONE_REMOTE=gdrive
