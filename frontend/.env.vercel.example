# Vercel Environment Variables (Project Settings -> Environment Variables)
# These are examples; set them in the Vercel dashboard, not by committing real secrets.

# Next.js rewrites target for backend API (must be HTTPS in production)
BACKEND_URL=https://api.your-free-domain.example

# Kakao Maps JavaScript key (client-side)
NEXT_PUBLIC_KAKAO_MAP_API_KEY=your_kakao_javascript_key
