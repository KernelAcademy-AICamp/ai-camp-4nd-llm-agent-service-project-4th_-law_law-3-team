{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",

  // Goal: 프롬프트를 보고 오케스트레이션이 필요할 때 역할/카테고리로 위임하면서,
  //       가벼운 작업은 로컬(Ollama)로 비용 절약, 어려운 작업은 OpenAI로 품질 확보.

  "agents": {
    // Main orchestrator: Claude가 없으니 OpenAI로 고정
    "sisyphus": { "model": "openai/gpt-5.3-codex-spark", "variant": "medium" },

    // Planner / reviewers
    "oracle": { "model": "openai/gpt-5.2", "variant": "high" },
    "prometheus": { "model": "openai/gpt-5.2", "variant": "high" },
    "metis": { "model": "openai/gpt-5.2", "variant": "high" },
    "momus": { "model": "openai/gpt-5.2", "variant": "medium" },
    "atlas": { "model": "openai/gpt-5.2" },

    // Coding-heavy subagent
    "hephaestus": { "model": "openai/gpt-5.3-codex-spark", "variant": "medium" },

    // Research / context
    "librarian": { "model": "opencode/big-pickle" },

    // Cheap/Local exploration (짧은 변경, 반복 작업, 초안 작성)
    "explore": { "model": "ollama/deepseek-coder-v2:16b-lite-instruct-q4_K_M" },

    // No Gemini; keep multimodal on OpenAI for now
    "multimodal-looker": { "model": "openai/gpt-5.2" }
  },

  "categories": {
    // Trivial tasks: 로컬로 (작은 수정, 로그/에러 메시지 정리, 짧은 코드 스니펫, 반복 작업)
    "quick": { "model": "ollama/deepseek-coder-v2:16b-lite-instruct-q4_K_M" },

    // Bigger reasoning / refactor / debugging: OpenAI로
    "deep": { "model": "openai/gpt-5.3-codex-spark", "variant": "medium" },
    "ultrabrain": { "model": "openai/gpt-5.3-codex", "variant": "xhigh" },

    // UI 작업도 (Gemini 없으면) OpenAI로
    "visual-engineering": { "model": "openai/gpt-5.3-codex-spark", "variant": "medium" },

    // 글/문서 정리는 OpenAI로
    "writing": { "model": "openai/gpt-5.2" }
  }
}
