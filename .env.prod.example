# ===========================================
# MVP Production Environment Template (Vercel frontend + server backend)
# ===========================================
# Usage:
#   cp .env.prod.example .env.prod
#   Fill secrets and domain values
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# ===========================================
# Domain / App (필수)
# ===========================================
ENVIRONMENT=production
CORS_ORIGINS=["https://your-project.vercel.app"]
# Backend API domain (free/custom domain) for Nginx server_name
# Example free domains: your-app.duckdns.org, your-app.ddns.net
API_DOMAIN=api.your-free-domain.example
# Optional backend API protection (X-API-Key). Leave empty to disable.
API_KEY=

# ===========================================
# Database (필수)
# ===========================================
POSTGRES_USER=lawuser
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=lawdb

# ===========================================
# Backend external APIs (기능 사용 시 필수)
# ===========================================
# AI provider selection: openai | anthropic | google
LLM_PROVIDER=openai

# OpenAI (OPENAI 기능 사용 시 필수)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Anthropic (LLM_PROVIDER=anthropic 시)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (LLM_PROVIDER=google / storyboard 일부 기능 시)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3-flash-preview

# Kakao APIs (지도/지오코딩 기능 사용 시)
KAKAO_MAP_API_KEY=your_kakao_javascript_key
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# Optional: Upstage evaluation tools
UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-pro3-260126

# ===========================================
# Vector DB / Retrieval (옵션)
# ===========================================
# Default is embedded LanceDB local mode for MVP.
VECTOR_DB=lancedb
LANCEDB_MODE=local
LANCEDB_URI=/app/lancedb_data
# Used when LANCEDB_MODE=remote and lancedb profile/service is enabled
LANCEDB_SERVICE_URL=http://lancedb:8100
LANCEDB_TABLE_NAME=legal_chunks
USE_LEGAL_TERM_DICT=false

# Chroma fallback settings (VECTOR_DB=chroma)
CHROMA_COLLECTION_NAME=legal_documents

# Qdrant settings (VECTOR_DB=qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=legal_documents

# ===========================================
# Graph DB (1차 MVP prod compose 미포함 / PostgreSQL 이관 후 미사용 예정)
# ===========================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ===========================================
# Backend runtime options (선택)
# ===========================================
USE_LOCAL_EMBEDDING=true
USE_DB_LAWYERS=false
ENABLED_MODULES=[]

# Rate limiting storage
# MVP single-instance default is memory://
# Multi-instance production should use Redis (e.g., redis://redis:6379/0)
RATE_LIMIT_STORAGE_URI=memory://

# ===========================================
# Vercel Frontend Environment (참고용 - Vercel 프로젝트에 설정)
# ===========================================
# BACKEND_URL=https://api.your-free-domain.example
# NEXT_PUBLIC_KAKAO_MAP_API_KEY=your_kakao_javascript_key
