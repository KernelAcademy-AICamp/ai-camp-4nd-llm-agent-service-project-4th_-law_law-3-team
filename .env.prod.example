# ===========================================
# MVP Production Environment Template (Vercel frontend + server backend)
# ===========================================
# Usage:
#   cp .env.prod.example .env.prod
#   Fill secrets and domain values
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# ===========================================
# Domain / App (필수)
# ===========================================
ENVIRONMENT=production
CORS_ORIGINS=["https://your-project.vercel.app"]
# Backend API domain (free/custom domain) for Nginx server_name
# Example free domains: your-app.duckdns.org, your-app.ddns.net
API_DOMAIN=api.your-free-domain.example
# Backend API protection (X-API-Key) — 프로덕션 필수
# 비어있으면 서비스 시작 불가 (docker-compose.prod.yml에서 강제)
API_KEY=your-strong-api-key-here

# ===========================================
# Database (필수)
# ===========================================
POSTGRES_USER=lawuser
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=lawdb

# ===========================================
# Backend external APIs (기능 사용 시 필수)
# ===========================================
# AI provider selection: openai | anthropic | google
LLM_PROVIDER=openai

# OpenAI (OPENAI 기능 사용 시 필수)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Anthropic (LLM_PROVIDER=anthropic 시)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (LLM_PROVIDER=google / storyboard 일부 기능 시)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3-flash-preview

# Kakao APIs (지도/지오코딩 기능 사용 시)
KAKAO_MAP_API_KEY=your_kakao_javascript_key
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# Optional: Upstage evaluation tools
UPSTAGE_API_KEY=
UPSTAGE_MODEL=solar-pro3-260126

# ===========================================
# Vector DB / Retrieval (옵션)
# ===========================================
# Default is embedded LanceDB local mode for MVP.
VECTOR_DB=lancedb
LANCEDB_MODE=local
LANCEDB_URI=/app/lancedb_data
# Used when LANCEDB_MODE=remote and lancedb profile/service is enabled
LANCEDB_SERVICE_URL=http://lancedb:8100
LANCEDB_TABLE_NAME=legal_chunks
USE_LEGAL_TERM_DICT=true

# Chroma fallback settings (VECTOR_DB=chroma)
CHROMA_COLLECTION_NAME=legal_documents

# Qdrant settings (VECTOR_DB=qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=legal_documents

# ===========================================
# Backend runtime options (선택)
# ===========================================
USE_LOCAL_EMBEDDING=true
LOCAL_EMBEDDING_MODEL=nlpai-lab/KURE-v1
USE_DB_LAWYERS=true
USE_HYBRID_SEARCH=true
USE_BM25_SEARCH=true
USE_PERSISTENT_CHECKPOINTER=true
LLM_TIMEOUT_SECONDS=60
AGENT_TIMEOUT_SECONDS=120
ENABLED_MODULES=[]

# Query Rewrite (비워두면 기본 provider 사용)
QUERY_REWRITE_PROVIDER=
QUERY_REWRITE_MODEL=

# Rate limiting
# MVP single-instance default is memory://
# Multi-instance production should use Redis (e.g., redis://redis:6379/0)
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_AI_PER_MINUTE=10

# ===========================================
# MeCab / Tokenizer (선택)
# ===========================================
# MeCab userdic 경로 (컨테이너 내부 기준)
MECAB_USERDIC_PATH=/app/mecab_userdic/legal_terms.dic

# ===========================================
# ONNX Optimization (ARM Graviton 프로덕션 기본)
# ===========================================
# ONNX 런타임 사용 (PyTorch 대비 경량, ARM 최적화)
# true 설정 시 PyTorch 모델 자동 다운로드를 건너뜀
USE_ONNX_EMBEDDING=true
USE_ONNX_RERANKER=true
# Variant: ort-opt (FP32 무손실) | ort-opt-qdq (INT8, 더 빠름)
ONNX_EMBEDDING_VARIANT=ort-opt
ONNX_RERANKER_VARIANT=ort-opt-qdq
# 품질 게이트: PyTorch vs ONNX 비교 (ONNX 전용 배포에서는 false)
# PyTorch 모델이 없으면 비교 불가 → false 필수
ONNX_QUALITY_GATE_ENABLED=false
# QDQ 민감 레이어 (비워두면 기본값 사용)
ONNX_QDQ_SENSITIVE_LAYERS=

# ===========================================
# TLS / Let's Encrypt (HTTPS 설정 시 필수)
# ===========================================
# 인증서 알림 수신 이메일
CERTBOT_EMAIL=your-email@example.com

# ===========================================
# External APIs — 뉴스/콘텐츠 (기능 사용 시)
# ===========================================
TAVILY_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
NEWSDATA_API_KEY=
NEWSAPI_API_KEY=

# ===========================================
# LangSmith 추적 (선택)
# ===========================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=law-platform
LANGCHAIN_API_KEY=

# ===========================================
# News Pipeline (선택)
# ===========================================
NEWS_PIPELINE_ENABLED=true
NEWS_PIPELINE_SUMMARY_PROVIDER=upstage
NEWS_PIPELINE_LANCEDB_TABLE=news_chunks
NEWS_PIPELINE_SLACK_WEBHOOK_URL=

# ===========================================
# Storyboard (선택)
# ===========================================
STORYBOARD_IMAGE_MODEL=gemini-3-pro-image-preview
STORYBOARD_MAX_PANELS=14

# ===========================================
# Vercel Frontend Environment (참고용 - Vercel 프로젝트에 설정)
# ===========================================
# BACKEND_URL=https://api.your-free-domain.example
# NEXT_PUBLIC_KAKAO_MAP_API_KEY=your_kakao_javascript_key
